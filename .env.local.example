# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see *.local in .gitignore) — never commit real secrets.

# Frontend only — safe to expose in the browser bundle.
# Points the chatbot at your deployed backend endpoint (Vercel function URL).
VITE_CHAT_API_URL=

# ── Everything below belongs to the BACKEND (Vercel project env vars), NOT this frontend ──
# Do not prefix these with VITE_ — that would bundle them into client-side JS and leak them publicly.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
